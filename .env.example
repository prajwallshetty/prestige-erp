# ---------------------------------------------------------------------------
# Technic Technologies Electronics ERP — environment template
#
# Copy this file to `.env` and fill in your real values. Only three variables
# are required to run the app. Nothing else is read by the code.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — point this at any PostgreSQL 14+ server. Examples:
#
#   Local Postgres:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/technic_erp?schema=public"
#
#   Neon (serverless):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/technic_erp?sslmode=require"
#
#   Supabase:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres"
#
# Create the database first (migrations create the tables):
#   createdb technic_erp        (or: CREATE DATABASE technic_erp; in psql)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/technic_erp?schema=public"

# ---------------------------------------------------------------------------
# Authentication — NextAuth v5 secret. Generate with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Canonical URL of the app (no trailing slash)
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Application — display name used in UI/PDF headers as a fallback
# (the seeded firm's own name takes priority at runtime)
# ---------------------------------------------------------------------------
APP_NAME="Technic Technologies ERP"
